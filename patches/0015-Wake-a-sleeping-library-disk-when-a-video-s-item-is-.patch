+using System;
+using System.Globalization;
+using System.Security.Claims;
+using System.Threading.Tasks;
+using Jellyfin.Api.Constants;
+using Jellyfin.Api.Controllers;
+using Jellyfin.Api.Helpers;
+using Jellyfin.Api.Tests.Helpers;
+using Jellyfin.Database.Implementations.Entities;
+using MediaBrowser.Controller.Dto;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Controller.Entities.Movies;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.Providers;
+using MediaBrowser.Model.Dto;
+using MediaBrowser.Model.Entities;
+using MediaBrowser.Model.IO;
+using MediaBrowser.Model.MediaInfo;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Api.Tests.Controllers;
+
+/// <summary>
+/// Opening a film's details page (GET /Items/{id}) starts the background read of its file (task 176).
+/// </summary>
+[Collection(MediaPrewarmSharedCollection.Name)]
+public class UserLibraryControllerPrewarmTests
+{
+    private readonly User _user = new("viewer", "auth", "reset") { Id = Guid.NewGuid() };
+    private readonly Mock<ILibraryManager> _library = new();
+    private readonly UserLibraryController _subject;
+
+    public UserLibraryControllerPrewarmTests()
+    {
+        var sources = new Mock<IMediaSourceManager>();
+        sources.Setup(m => m.GetPathProtocol(It.IsAny<string>())).Returns(MediaProtocol.File);
+        BaseItem.MediaSourceManager = sources.Object;
+
+        var users = new Mock<IUserManager>();
+        users.Setup(m => m.GetUserById(_user.Id)).Returns(_user);
+        var dto = new Mock<IDtoService>();
+        dto.Setup(m => m.GetBaseItemDto(It.IsAny<BaseItem>(), It.IsAny<DtoOptions>(), It.IsAny<User>(), It.IsAny<BaseItem>()))
+            .Returns(new BaseItemDto());
+
+        _subject = new UserLibraryController(
+            users.Object,
+            Mock.Of<IUserDataManager>(),
+            _library.Object,
+            dto.Object,
+            Mock.Of<IUserViewManager>(),
+            Mock.Of<IFileSystem>(),
+            Mock.Of<IProviderManager>());
+
+        var claims = new[]
+        {
+            new Claim(InternalClaimTypes.UserId, _user.Id.ToString("N", CultureInfo.InvariantCulture)),
+            new Claim(InternalClaimTypes.IsApiKey, bool.FalseString),
+        };
+        _subject.ControllerContext = new ControllerContext
+        {
+            HttpContext = new DefaultHttpContext { User = new ClaimsPrincipal(new ClaimsIdentity(claims, "test")) }
+        };
+    }
+
+    [Fact]
+    public async Task GetItem_Film_ClaimsItsFileForAWarm()
+    {
+        var path = "/nonexistent/task176/" + Guid.NewGuid().ToString("N") + ".mkv";
+        var film = new Movie { Id = Guid.NewGuid(), Path = path, VideoType = VideoType.VideoFile };
+        _library.Setup(m => m.GetItemById<BaseItem>(film.Id, _user)).Returns(film);
+
+        var result = await _subject.GetItem(null, film.Id);
+
+        Assert.NotNull(result.Value);
+        // The fetch already took this file's slot, so a second claim inside 5 minutes is refused.
+        Assert.False(MediaPrewarm.Shared.Claim(path));
+    }
+
+    [Fact]
+    public async Task GetItem_LegacyRoute_AlsoWarms()
+    {
+        var path = "/nonexistent/task176/" + Guid.NewGuid().ToString("N") + ".mkv";
+        var film = new Movie { Id = Guid.NewGuid(), Path = path, VideoType = VideoType.VideoFile };
+        _library.Setup(m => m.GetItemById<BaseItem>(film.Id, _user)).Returns(film);
+
+#pragma warning disable CS0618 // legacy route kept for older clients
+        await _subject.GetItemLegacy(_user.Id, film.Id);
+#pragma warning restore CS0618
+
+        Assert.False(MediaPrewarm.Shared.Claim(path));
+    }
+}
