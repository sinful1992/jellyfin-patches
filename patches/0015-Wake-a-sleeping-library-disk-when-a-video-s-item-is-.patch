diff --git a/Jellyfin.Api/Helpers/MediaPrewarm.cs b/Jellyfin.Api/Helpers/MediaPrewarm.cs
new file mode 100644
index 0000000000..1f80041b51
--- /dev/null
+++ b/Jellyfin.Api/Helpers/MediaPrewarm.cs
@@ -0,0 +1,252 @@
+using System;
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.IO;
+using System.Threading;
+using System.Threading.Tasks;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Model.Entities;
+using Microsoft.Extensions.Logging;
+
+namespace Jellyfin.Api.Helpers;
+
+/// <summary>
+/// Reads a few blocks of a video's file in the background when its item is fetched, so a library disk
+/// that has gone to sleep is spinning again by the time the viewer presses Play.
+/// </summary>
+/// <remarks>
+/// Built for one pattern: whole-file stream starts that wait 9-13 s for the first byte, a fixed time per
+/// storage volume, almost only after an hour or more without reads on that volume (the StreamTiming line
+/// puts all of it in the file open + first read). That is a sleeping disk spinning up. A viewer looks at
+/// the details page for a few seconds before Play, and that page fetches the item, so the spin-up can
+/// happen then instead of after Play. The read never delays or fails the request that triggered it, each
+/// file is read at most once per <see cref="Interval"/>, and at most <see cref="MaxRunning"/> reads run
+/// at once; anything over that is skipped, not queued.
+/// </remarks>
+public sealed class MediaPrewarm
+{
+    /// <summary>Bytes read at each place in the file.</summary>
+    public const int BlockSize = 64 * 1024;
+
+    /// <summary>Most reads running at once.</summary>
+    public const int MaxRunning = 2;
+
+    /// <summary>Remembered files before old entries are dropped.</summary>
+    public const int MaxRemembered = 4096;
+
+    private const string LoggerName = "Jellyfin.Api.Helpers.MediaPrewarm";
+
+    /// <summary>Shortest time between two reads of the same file.</summary>
+    public static readonly TimeSpan Interval = TimeSpan.FromMinutes(5);
+
+    private readonly ConcurrentDictionary<string, DateTime> _lastWarm = new(StringComparer.Ordinal);
+    private readonly Func<DateTime> _now;
+    private readonly Func<string, CancellationToken, Task<long>> _read;
+    private int _running;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="MediaPrewarm"/> class.
+    /// </summary>
+    /// <param name="now">Clock (UTC).</param>
+    /// <param name="read">Reads the blocks of a file; returns the bytes read.</param>
+    public MediaPrewarm(Func<DateTime>? now = null, Func<string, CancellationToken, Task<long>>? read = null)
+    {
+        _now = now ?? (() => DateTime.UtcNow);
+        _read = read ?? ReadBlocksAsync;
+    }
+
+    /// <summary>Gets the instance the API uses.</summary>
+    public static MediaPrewarm Shared { get; } = new();
+
+    /// <summary>Gets how many files are remembered (for tests).</summary>
+    public int RememberedCount => _lastWarm.Count;
+
+    /// <summary>
+    /// Whether an item is a playable video backed by one local file.
+    /// </summary>
+    /// <param name="item">The item.</param>
+    /// <returns>The file path, or <c>null</c> when there is nothing to warm.</returns>
+    public static string? FileToWarm(BaseItem? item)
+    {
+        if (item is not Video video
+            || video.IsFolder
+            || video.IsVirtualItem
+            || video.IsShortcut
+            || !video.IsFileProtocol
+            || video.VideoType != VideoType.VideoFile
+            || string.IsNullOrEmpty(video.Path))
+        {
+            return null;
+        }
+
+        return video.Path;
+    }
+
+    /// <summary>
+    /// Starts a background read of the item's file when the rules allow it. Never throws, never waits.
+    /// </summary>
+    /// <param name="item">The item that was fetched.</param>
+    /// <param name="loggerFactory">For the Prewarm line.</param>
+    /// <param name="trigger">What fetched the item, for the log line.</param>
+    /// <returns>The read, or <c>null</c> when skipped (for tests).</returns>
+    public Task? TryStart(BaseItem? item, ILoggerFactory? loggerFactory, string trigger)
+    {
+        try
+        {
+            var path = FileToWarm(item);
+            if (path is null || !Claim(path))
+            {
+                return null;
+            }
+
+            if (Interlocked.Increment(ref _running) > MaxRunning)
+            {
+                Interlocked.Decrement(ref _running);
+
+                // Busy: give the slot back so a later fetch can try again.
+                _lastWarm.TryRemove(path, out _);
+                return null;
+            }
+
+            var logger = loggerFactory?.CreateLogger(LoggerName);
+            var id = item!.Id;
+            return Task.Run(async () =>
+            {
+                var watch = Stopwatch.StartNew();
+                try
+                {
+                    using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(1));
+                    var bytes = await _read(path, cts.Token).ConfigureAwait(false);
+                    watch.Stop();
+                    // Information always: at most one line per file per 5 minutes, and the live check needs it.
+                    logger?.LogInformation(
+                        "Prewarm {ItemId} {Ms} ms, {Bytes} bytes, trigger {Trigger}",
+                        id.ToString("N", System.Globalization.CultureInfo.InvariantCulture),
+                        (long)watch.Elapsed.TotalMilliseconds,
+                        bytes,
+                        trigger);
+                }
+                catch (Exception ex)
+                {
+                    logger?.LogDebug(ex, "Prewarm {ItemId} failed after {Ms} ms", id, (long)watch.Elapsed.TotalMilliseconds);
+                }
+                finally
+                {
+                    Interlocked.Decrement(ref _running);
+                }
+            });
+        }
+        catch (Exception)
+        {
+            return null;
+        }
+    }
+
+    /// <summary>
+    /// Takes the right to warm a file now; false when it was warmed less than <see cref="Interval"/> ago.
+    /// </summary>
+    /// <param name="path">The file.</param>
+    /// <returns>Whether to warm it.</returns>
+    public bool Claim(string path)
+    {
+        var now = _now();
+        while (true)
+        {
+            if (_lastWarm.TryGetValue(path, out var last))
+            {
+                // A clock that went back counts as expired, so a file is never locked out.
+                if (now - last < Interval && now >= last)
+                {
+                    return false;
+                }
+
+                if (_lastWarm.TryUpdate(path, now, last))
+                {
+                    return true;
+                }
+
+                continue;
+            }
+
+            if (_lastWarm.Count >= MaxRemembered)
+            {
+                Prune(now);
+            }
+
+            if (_lastWarm.TryAdd(path, now))
+            {
+                return true;
+            }
+        }
+    }
+
+    private void Prune(DateTime now)
+    {
+        foreach (var entry in _lastWarm)
+        {
+            if (now - entry.Value >= Interval || now < entry.Value)
+            {
+                _lastWarm.TryRemove(entry.Key, out _);
+            }
+        }
+
+        // Thousands of files fetched inside 5 minutes: forgetting them only means a second warm.
+        if (_lastWarm.Count >= MaxRemembered)
+        {
+            _lastWarm.Clear();
+        }
+    }
+
+    /// <summary>
+    /// Reads the first block (where playback starts), the last block (where a player looks for the
+    /// index) and one block in the middle (most likely not in the page cache, so it reaches the disk).
+    /// </summary>
+    /// <param name="path">The file.</param>
+    /// <param name="cancellationToken">Cancellation.</param>
+    /// <returns>Bytes read.</returns>
+    public static async Task<long> ReadBlocksAsync(string path, CancellationToken cancellationToken)
+    {
+        var buffer = new byte[BlockSize];
+        long total = 0;
+        var stream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete, 1, FileOptions.Asynchronous);
+        await using (stream.ConfigureAwait(false))
+        {
+            var length = stream.Length;
+            foreach (var offset in BlockOffsets(length))
+            {
+                stream.Position = offset;
+                total += await stream.ReadAsync(buffer, cancellationToken).ConfigureAwait(false);
+            }
+        }
+
+        return total;
+    }
+
+    /// <summary>
+    /// Where <see cref="ReadBlocksAsync"/> reads, for a file of a given length: start, middle, end;
+    /// duplicates dropped for small files.
+    /// </summary>
+    /// <param name="length">File length.</param>
+    /// <returns>Offsets, ascending.</returns>
+    public static long[] BlockOffsets(long length)
+    {
+        if (length <= 0)
+        {
+            return [];
+        }
+
+        if (length <= BlockSize)
+        {
+            return [0];
+        }
+
+        var last = length - BlockSize;
+        var middle = length / 2 / BlockSize * BlockSize;
+        if (middle <= 0 || middle >= last)
+        {
+            return [0, last];
+        }
+
+        return [0, middle, last];
+    }
+}
