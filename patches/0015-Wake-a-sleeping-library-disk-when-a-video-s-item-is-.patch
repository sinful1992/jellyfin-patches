@@ -0,0 +1,182 @@
+using System;
+using System.IO;
+using System.Threading;
+using System.Threading.Tasks;
+using Jellyfin.Api.Helpers;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Controller.Entities.Movies;
+using MediaBrowser.Controller.Entities.TV;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Model.Entities;
+using MediaBrowser.Model.MediaInfo;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Api.Tests.Helpers
+{
+    [Collection(MediaPrewarmSharedCollection.Name)]
+    public class MediaPrewarmTests
+    {
+        public MediaPrewarmTests()
+        {
+            var sources = new Mock<IMediaSourceManager>();
+            sources.Setup(m => m.GetPathProtocol(It.IsAny<string>()))
+                .Returns<string>(p => p.StartsWith("http", StringComparison.Ordinal) ? MediaProtocol.Http : MediaProtocol.File);
+            BaseItem.MediaSourceManager = sources.Object;
+        }
+
+        private static Movie Film(string path = "/data/movies/a.mkv") => new() { Id = Guid.NewGuid(), Path = path, VideoType = VideoType.VideoFile };
+
+        [Fact]
+        public void FileToWarm_FilmAndEpisode()
+        {
+            Assert.Equal("/data/movies/a.mkv", MediaPrewarm.FileToWarm(Film()));
+            Assert.Equal("/data/tv/e.mkv", MediaPrewarm.FileToWarm(new Episode { Path = "/data/tv/e.mkv", VideoType = VideoType.VideoFile }));
+        }
+
+        [Fact]
+        public void FileToWarm_SkipsWhatIsNotOneLocalFile()
+        {
+            Assert.Null(MediaPrewarm.FileToWarm(null));
+            Assert.Null(MediaPrewarm.FileToWarm(new Series { Path = "/data/tv/show" }));
+            Assert.Null(MediaPrewarm.FileToWarm(new Folder { Path = "/data/movies" }));
+            Assert.Null(MediaPrewarm.FileToWarm(new Movie { Path = "/data/movies/disc", VideoType = VideoType.BluRay }));
+            Assert.Null(MediaPrewarm.FileToWarm(new Movie { Path = "/data/movies/a.strm", VideoType = VideoType.VideoFile, IsShortcut = true }));
+            Assert.Null(MediaPrewarm.FileToWarm(new Movie { Path = "https://example.invalid/a.mkv", VideoType = VideoType.VideoFile }));
+            Assert.Null(MediaPrewarm.FileToWarm(new Movie { Path = string.Empty, VideoType = VideoType.VideoFile }));
+            Assert.Null(MediaPrewarm.FileToWarm(new Episode { Path = "/data/tv/missing.mkv", VideoType = VideoType.VideoFile, IsVirtualItem = true }));
+        }
+
+        [Fact]
+        public void Claim_OncePerInterval_PerFile()
+        {
+            var now = new DateTime(2026, 11, 17, 9, 0, 0, DateTimeKind.Utc);
+            var p = new MediaPrewarm(() => now, (_, _) => Task.FromResult(0L));
+            Assert.True(p.Claim("/a"));
+            Assert.False(p.Claim("/a"));
+            Assert.True(p.Claim("/b"), "another file is independent");
+            now = now.AddMinutes(4).AddSeconds(59);
+            Assert.False(p.Claim("/a"));
+            now = now.AddSeconds(1);
+            Assert.True(p.Claim("/a"), "5 min later it may warm again");
+        }
+
+        [Fact]
+        public void Claim_ClockGoingBack_DoesNotLockTheFileOut()
+        {
+            var now = new DateTime(2026, 11, 17, 9, 0, 0, DateTimeKind.Utc);
+            var p = new MediaPrewarm(() => now, (_, _) => Task.FromResult(0L));
+            Assert.True(p.Claim("/a"));
+            now = now.AddHours(-2);
+            Assert.True(p.Claim("/a"));
+        }
+
+        [Fact]
+        public void Claim_ManyFiles_StaysBounded()
+        {
+            var now = new DateTime(2026, 11, 17, 9, 0, 0, DateTimeKind.Utc);
+            var p = new MediaPrewarm(() => now, (_, _) => Task.FromResult(0L));
+            for (var i = 0; i < MediaPrewarm.MaxRemembered * 2; i++)
+            {
+                Assert.True(p.Claim("/f" + i));
+            }
+
+            Assert.True(p.RememberedCount <= MediaPrewarm.MaxRemembered);
+
+            // A file seen just now is still known, so it is not warmed twice.
+            Assert.False(p.Claim("/f" + ((MediaPrewarm.MaxRemembered * 2) - 1)));
+
+            // Old entries are pruned first: 5 min later the map makes room without forgetting new ones.
+            now = now.AddMinutes(6);
+            Assert.True(p.Claim("/new"));
+            Assert.False(p.Claim("/new"));
+        }
+
+        [Fact]
+        public async Task TryStart_RunsOnce_AndNeverThrowsFromTheRead()
+        {
+            var calls = 0;
+            var p = new MediaPrewarm(read: (_, _) =>
+            {
+                Interlocked.Increment(ref calls);
+                throw new IOException("NAS gone");
+            });
+            var film = Film();
+            var t = p.TryStart(film, null, "item");
+            Assert.NotNull(t);
+            await t!;
+            Assert.Null(p.TryStart(film, null, "item"));
+            Assert.Equal(1, calls);
+        }
+
+        [Fact]
+        public void TryStart_SkipsWhenTwoAreRunning_AndDoesNotWait()
+        {
+            var gate = new TaskCompletionSource<long>();
+            var p = new MediaPrewarm(read: (_, _) => gate.Task);
+            Assert.NotNull(p.TryStart(Film("/1"), null, "item"));
+            Assert.NotNull(p.TryStart(Film("/2"), null, "item"));
+            Assert.Null(p.TryStart(Film("/3"), null, "item"));
+            gate.SetResult(0);
+        }
+
+        [Fact]
+        public async Task TryStart_SkippedWhileBusy_CanWarmLater()
+        {
+            var gate = new TaskCompletionSource<long>();
+            var p = new MediaPrewarm(read: (_, _) => gate.Task);
+            var a = p.TryStart(Film("/1"), null, "item");
+            var b = p.TryStart(Film("/2"), null, "item");
+            Assert.Null(p.TryStart(Film("/3"), null, "item"));
+            gate.SetResult(0);
+            await Task.WhenAll(a!, b!);
+            Assert.NotNull(p.TryStart(Film("/3"), null, "item"));
+        }
+
+        [Fact]
+        public void TryStart_NotAVideo_Skipped()
+        {
+            var p = new MediaPrewarm(read: (_, _) => Task.FromResult(0L));
+            Assert.Null(p.TryStart(new Series { Path = "/data/tv/show" }, null, "item"));
+        }
+
+        [Theory]
+        [InlineData(0L, new long[0])]
+        [InlineData(1L, new long[] { 0 })]
+        [InlineData(65536L, new long[] { 0 })]
+        [InlineData(65537L, new long[] { 0, 1 })]
+        [InlineData(200000L, new long[] { 0, 65536, 134464 })]
+        public void BlockOffsets(long length, long[] expected)
+        {
+            Assert.Equal(expected, MediaPrewarm.BlockOffsets(length));
+        }
+
+        [Fact]
+        public async Task ReadBlocksAsync_ReadsStartMiddleEnd()
+        {
+            var path = Path.GetTempFileName();
+            try
+            {
+                await File.WriteAllBytesAsync(path, new byte[(3 * MediaPrewarm.BlockSize) + 10], TestContext.Current.CancellationToken);
+                Assert.Equal(3 * MediaPrewarm.BlockSize, await MediaPrewarm.ReadBlocksAsync(path, CancellationToken.None));
