+++ b/tests/Jellyfin.Controller.Tests/MediaEncoding/StreamRequestTimerTests.cs
@@ -0,0 +1,100 @@
+using System;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using MediaBrowser.Controller.MediaEncoding;
+using Xunit;
+
+namespace Jellyfin.Controller.Tests.MediaEncoding;
+
+public class StreamRequestTimerTests
+{
+    [Fact]
+    public async Task Mark_WithoutActiveTimer_IsNoOp()
+    {
+        void Body()
+        {
+            StreamRequestTimer.Current = null;
+            StreamRequestTimer.Mark("orphan");
+            StreamRequestTimer.Note("orphan", TimeSpan.FromSeconds(1));
+            Assert.Null(StreamRequestTimer.Current);
+        }
+
+        await Task.Run(Body, TestContext.Current.CancellationToken);
+    }
+
+    [Fact]
+    public async Task Describe_ListsPhasesInOrder()
+    {
+        var timer = new StreamRequestTimer();
+
+        void Body()
+        {
+            StreamRequestTimer.Current = timer;
+            StreamRequestTimer.Mark("auth");
+            StreamRequestTimer.Mark("item");
+            StreamRequestTimer.Mark("first-byte");
+        }
+
+        await Task.Run(Body, TestContext.Current.CancellationToken);
+
+        var phases = timer.Describe().Split(", ").Select(p => p.Split(' ')[0]).ToArray();
+        Assert.Equal(new[] { "auth", "item", "first-byte" }, phases);
+    }
+
+    [Fact]
+    public async Task ActiveTimer_FlowsIntoAwaitedParallelWork()
+    {
+        // The media source manager runs its providers with Task.WhenAll, below the API layer;
+        // their notes only reach the request if the active timer flows into those tasks.
+        var ct = TestContext.Current.CancellationToken;
+        var timer = new StreamRequestTimer();
+
+        async Task ProviderA()
+        {
+            await Task.Yield();
+            StreamRequestTimer.Note("providerA", TimeSpan.FromMilliseconds(5));
+        }
+
+        async Task ProviderB()
+        {
+            await Task.Delay(1, ct);
+            StreamRequestTimer.Note("providerB", TimeSpan.FromMilliseconds(7));
+        }
+
+        async Task Request()
+        {
+            StreamRequestTimer.Current = timer;
+            await Task.WhenAll(Task.Run(ProviderA, ct), Task.Run(ProviderB, ct));
+            StreamRequestTimer.Mark("dynamic-sources");
+        }
+
+        await Task.Run(Request, ct);
+
+        var described = timer.Describe();
+        Assert.StartsWith("dynamic-sources ", described, StringComparison.Ordinal);
+        Assert.Contains("providerA 5", described, StringComparison.Ordinal);
+        Assert.Contains("providerB 7", described, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public async Task TimerSetInsideAwaitedCall_DoesNotLeakToCaller()
+    {
+        // Why the API layer keeps the timer in HttpContext.Items and re-activates it in the
+        // action: a value set inside an awaited call (the auth handler) is gone afterwards.
+        static async Task SetTimerAsync()
+        {
+            await Task.Yield();
+            StreamRequestTimer.Current = new StreamRequestTimer();
+        }
+
+        async Task Caller()
+        {
+            StreamRequestTimer.Current = null;
+            await SetTimerAsync();
+            Assert.Null(StreamRequestTimer.Current);
+        }
+
+        await Task.Run(Caller, TestContext.Current.CancellationToken);
+    }
+}
