diff --git a/MediaBrowser.Controller/MediaEncoding/StreamRequestTimer.cs b/MediaBrowser.Controller/MediaEncoding/StreamRequestTimer.cs
new file mode 100644
index 0000000000..1834826638
--- /dev/null
+++ b/MediaBrowser.Controller/MediaEncoding/StreamRequestTimer.cs
@@ -0,0 +1,119 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Globalization;
+using System.Text;
+using System.Threading;
+
+namespace MediaBrowser.Controller.MediaEncoding;
+
+/// <summary>
+/// Times the phases of one media stream request, so a slow start can be attributed to a phase
+/// instead of guessed at.
+/// </summary>
+/// <remarks>
+/// The active timer rides an <see cref="AsyncLocal{T}"/>, so code below the API layer
+/// (the media source manager, its providers) marks its own phases without being handed the
+/// request. <see cref="Mark"/> with no active timer is a no-op, so the library code paths
+/// that also serve scans and PlaybackInfo pay nothing.
+/// </remarks>
+public sealed class StreamRequestTimer
+{
+    private static readonly AsyncLocal<StreamRequestTimer?> _current = new();
+
+    private readonly long _start = Stopwatch.GetTimestamp();
+    private readonly List<(string Phase, long Timestamp)> _marks = [];
+    private readonly List<string> _notes = [];
+    private readonly Lock _lock = new();
+
+    /// <summary>
+    /// Gets or sets the timer for the request running on the current async flow.
+    /// </summary>
+    public static StreamRequestTimer? Current
+    {
+        get => _current.Value;
+        set => _current.Value = value;
+    }
+
+    /// <summary>
+    /// Gets the wall-clock time the timer was created.
+    /// </summary>
+    public DateTime StartedUtc { get; } = DateTime.UtcNow;
+
+    /// <summary>
+    /// Gets the time elapsed since the timer was created.
+    /// </summary>
+    public TimeSpan Elapsed => Stopwatch.GetElapsedTime(_start);
+
+    /// <summary>
+    /// Marks the end of a phase on the active timer, if there is one.
+    /// </summary>
+    /// <param name="phase">The phase that just finished.</param>
+    public static void Mark(string phase) => _current.Value?.Add(phase);
+
+    /// <summary>
+    /// Marks the end of a phase on this timer.
+    /// </summary>
+    /// <param name="phase">The phase that just finished.</param>
+    public void Add(string phase)
+    {
+        var now = Stopwatch.GetTimestamp();
+        lock (_lock)
+        {
+            _marks.Add((phase, now));
+        }
+    }
+
+    /// <summary>
+    /// Records something measured inside a phase, such as one of several media source
+    /// providers that run in parallel and so cannot be told apart by their marks.
+    /// </summary>
+    /// <param name="name">What was measured.</param>
+    /// <param name="elapsed">How long it took.</param>
+    public static void Note(string name, TimeSpan elapsed)
+    {
+        var timer = _current.Value;
+        if (timer is null)
+        {
+            return;
+        }
+
+        var text = name + " " + elapsed.TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture);
+        lock (timer._lock)
+        {
+            timer._notes.Add(text);
+        }
+    }
+
+    /// <summary>
+    /// Describes the phases in order, each with the time it took since the previous mark.
+    /// </summary>
+    /// <returns>A string such as <c>auth 1, item 0, media-sources 9301, first-byte 4 (provider X 9298)</c>, in milliseconds.</returns>
+    public string Describe()
+    {
+        var sb = new StringBuilder();
+        lock (_lock)
+        {
+            var previous = _start;
+            foreach (var (phase, timestamp) in _marks)
+            {
+                if (sb.Length > 0)
+                {
+                    sb.Append(", ");
+                }
+
+                sb.Append(phase)
+                    .Append(' ')
+                    .Append(Stopwatch.GetElapsedTime(previous, timestamp).TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture));
+                previous = timestamp;
+            }
+
+            if (_notes.Count > 0)
+            {
+                sb.Append(" (").AppendJoin(", ", _notes).Append(')');
+            }
+        }
+
+        return sb.ToString();
+    }
+}
diff --git a/tests/Jellyfin.Controller.Tests/MediaEncoding/StreamRequestTimerTests.cs b/tests/Jellyfin.Controller.Tests/MediaEncoding/StreamRequestTimerTests.cs
