diff --git a/Jellyfin.Api/Helpers/StreamTiming.cs b/Jellyfin.Api/Helpers/StreamTiming.cs
new file mode 100644
index 0000000000..2ced9dba07
--- /dev/null
+++ b/Jellyfin.Api/Helpers/StreamTiming.cs
@@ -0,0 +1,118 @@
+using System;
+using System.Globalization;
+using System.Threading.Tasks;
+using MediaBrowser.Common.Extensions;
+using MediaBrowser.Controller.MediaEncoding;
+using Microsoft.AspNetCore.Http;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging;
+
+namespace Jellyfin.Api.Helpers;
+
+/// <summary>
+/// Attaches a <see cref="StreamRequestTimer"/> to a media stream request and logs where the
+/// time to the first byte went.
+/// </summary>
+/// <remarks>
+/// Built for one question: some first GETs of a direct play hold for ~9 s before the client
+/// sees anything, while PlaybackInfo is fast and nothing else is logged. A video stream
+/// request always gets one line, so a slow start with no slow line here rules the server out
+/// as surely as a slow line rules it in. Other ticketed routes (audio, HLS segments) are
+/// logged only when slow, to keep segment traffic out of the log.
+/// </remarks>
+public static class StreamTiming
+{
+    private const string LoggerName = "Jellyfin.Api.Helpers.StreamTiming";
+    private static readonly object _itemsKey = new();
+    private static readonly object _alwaysLogKey = new();
+    private static readonly TimeSpan _slow = TimeSpan.FromSeconds(1);
+
+    /// <summary>
+    /// Gets the timer for this request, creating it on first use.
+    /// </summary>
+    /// <param name="httpContext">The request.</param>
+    /// <returns>The request's timer.</returns>
+    public static StreamRequestTimer For(HttpContext httpContext)
+    {
+        ArgumentNullException.ThrowIfNull(httpContext);
+
+        if (httpContext.Items.TryGetValue(_itemsKey, out var existing) && existing is StreamRequestTimer timer)
+        {
+            return timer;
+        }
+
+        timer = new StreamRequestTimer();
+        httpContext.Items[_itemsKey] = timer;
+        httpContext.Response.OnStarting(
+            static state =>
+            {
+                var (context, t) = ((HttpContext, StreamRequestTimer))state;
+                t.Add("first-byte");
+                Log(context, t, "first byte");
+                return Task.CompletedTask;
+            },
+            (httpContext, timer));
+        httpContext.Response.OnCompleted(
+            static state =>
+            {
+                var (context, t) = ((HttpContext, StreamRequestTimer))state;
+                if (!context.Response.HasStarted)
+                {
+                    t.Add("ended");
+                    Log(context, t, "no first byte");
+                }
+
+                return Task.CompletedTask;
+            },
+            (httpContext, timer));
+
+        return timer;
+    }
+
+    /// <summary>
+    /// Makes this request's timer the active one for the rest of the calling async flow, so
+    /// the library code it awaits can mark phases too.
+    /// </summary>
+    /// <param name="httpContext">The request.</param>
+    /// <param name="alwaysLog">Whether to log this request even when it is fast.</param>
+    public static void Activate(HttpContext httpContext, bool alwaysLog)
+    {
+        var timer = For(httpContext);
+        if (alwaysLog)
+        {
+            httpContext.Items[_alwaysLogKey] = true;
+        }
+
+        timer.Add("binding");
+        StreamRequestTimer.Current = timer;
+    }
+
+    private static void Log(HttpContext context, StreamRequestTimer timer, string outcome)
+    {
+        var elapsed = timer.Elapsed;
+        var slow = elapsed >= _slow;
+        if (!slow && !context.Items.ContainsKey(_alwaysLogKey))
+        {
+            return;
+        }
+
+        var logger = context.RequestServices.GetService<ILoggerFactory>()?.CreateLogger(LoggerName);
+        if (logger is null)
+        {
+            return;
+        }
+
+        logger.Log(
+            slow ? LogLevel.Warning : LogLevel.Information,
+            "Stream {Outcome} after {ElapsedMs} ms: {Method} {Path} {Status} from {RemoteIp} range {Range}, started {Started} local: {Phases}",
+            outcome,
+            elapsed.TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture),
+            context.Request.Method,
+            context.Request.Path.Value,
+            context.Response.StatusCode,
+            context.GetNormalizedRemoteIP(),
+            context.Request.Headers.Range.ToString() is { Length: > 0 } range ? range : "none",
+            timer.StartedUtc.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture),
+            timer.Describe());
+    }
+}
