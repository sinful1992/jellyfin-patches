diff --git a/Emby.Server.Implementations/Library/IMediaStreamPrefetch.cs b/Emby.Server.Implementations/Library/IMediaStreamPrefetch.cs
new file mode 100644
index 0000000000..cbe7835e20
--- /dev/null
+++ b/Emby.Server.Implementations/Library/IMediaStreamPrefetch.cs
@@ -0,0 +1,25 @@
+using System;
+using System.Collections.Generic;
+
+namespace Emby.Server.Implementations.Library
+{
+    /// <summary>
+    /// Batch-reads the media streams of many items for the duration of one request.
+    /// </summary>
+    /// <remarks>
+    /// Internal to this assembly on purpose. The public <c>IMediaSourceManager</c> lives in
+    /// MediaBrowser.Controller, which plugins bind against; this fork leaves that assembly as
+    /// upstream ships it. <see cref="MediaSourceManager"/> implements this, and
+    /// <see cref="Emby.Server.Implementations.Dto.DtoService"/> type-tests for it.
+    /// </remarks>
+    public interface IMediaStreamPrefetch
+    {
+        /// <summary>
+        /// Reads the streams of <paramref name="itemIds"/> in one query and serves every
+        /// whole-item stream read for those items from that batch until the scope is disposed.
+        /// </summary>
+        /// <param name="itemIds">The items a page is about to render.</param>
+        /// <returns>A scope; dispose it when the page is built.</returns>
+        IDisposable PrefetchMediaStreams(IReadOnlyList<Guid> itemIds);
+    }
+}
