+        /// <summary>
+        /// Media streams batch-read for the items of the current request, keyed by item id.
+        /// Set by <see cref="PrefetchMediaStreams"/>; consulted by <see cref="GetMediaStreams(MediaStreamQuery)"/>.
+        /// </summary>
+        private static readonly AsyncLocal<Dictionary<Guid, IReadOnlyList<MediaStream>>> _prefetchedStreams = new();
+
         public void AddParts(IEnumerable<IMediaSourceProvider> providers)
         {
             _providers = providers.ToArray();
         }
 
+        /// <inheritdoc />
+        public IDisposable PrefetchMediaStreams(IReadOnlyList<Guid> itemIds)
+        {
+            if (itemIds.Count == 0 || _mediaStreamRepository is not MediaStreamRepository repository)
+            {
+                return NoopPrefetch.Instance;
+            }
+
+            var batch = repository.GetMediaStreamsByItems(itemIds);
+            var prefetched = new Dictionary<Guid, IReadOnlyList<MediaStream>>(itemIds.Count);
+            foreach (var itemId in itemIds)
+            {
+                // An item the batch did not return has no streams. Record that, so the lookup
+                // below does not fall through to a per-item query for exactly the empty case.
+                var streams = batch.GetValueOrDefault(itemId) ?? Array.Empty<MediaStream>();
+                foreach (var stream in streams)
+                {
+                    stream.SupportsExternalStream = StreamSupportsExternalStream(stream);
+                }
+
+                prefetched[itemId] = streams;
+            }
+
+            var previous = _prefetchedStreams.Value;
+            _prefetchedStreams.Value = prefetched;
+            return new PrefetchScope(() => _prefetchedStreams.Value = previous);
+        }
+
         public IReadOnlyList<MediaStream> GetMediaStreams(MediaStreamQuery query)
         {
+            // A whole-item read inside a prefetch scope is answered from the batch. The scope is
+            // AsyncLocal, so it is confined to the request that opened it: nothing is cached across
+            // requests and there is no staleness window to reason about.
+            if (query.Index is null
+                && query.Type is null
+                && _prefetchedStreams.Value is { } prefetched
+                && prefetched.TryGetValue(query.ItemId, out var fromBatch))
+            {
+                return fromBatch;
+            }
+
             var list = _mediaStreamRepository.GetMediaStreams(query);
 
             foreach (var stream in list)
@@ -1066,5 +1112,31 @@ namespace Emby.Server.Implementations.Library
                 _liveStreamLocker.Dispose();
             }
         }
+
+        private sealed class PrefetchScope : IDisposable
+        {
+            private Action _onDispose;
+
+            public PrefetchScope(Action onDispose)
+            {
+                _onDispose = onDispose;
+            }
+
+            public void Dispose()
+            {
+                _onDispose?.Invoke();
+                _onDispose = null;
+            }
+        }
+
+        private sealed class NoopPrefetch : IDisposable
+        {
+            public static readonly NoopPrefetch Instance = new();
+
+            public void Dispose()
+            {
+            }
+        }
+
     }
