+        /// <summary>
+        /// Opens a request-scoped batch of media streams for the items whose DTOs will read them.
+        /// </summary>
+        /// <returns>The scope to dispose when the page is built, or null when nothing was prefetched.</returns>
+        private IDisposable? PrefetchMediaStreams(IReadOnlyList<BaseItem> items, DtoOptions options)
+        {
+            if (_mediaSourceManager is not IMediaStreamPrefetch prefetch)
+            {
+                return null;
+            }
+
+            var wantsStreams = options.ContainsField(ItemFields.MediaSources)
+                || options.ContainsField(ItemFields.MediaStreams)
+                || options.ContainsField(ItemFields.Trickplay);
+
+            var itemIds = new List<Guid>(items.Count);
+            foreach (var item in items)
+            {
+                // Audio always reads its streams (HasLyrics); video only when a field asks for them.
+                // Channel-sourced items get their sources from the channel, not from the database.
+                if (item is IHasMediaSources && item.SourceType == SourceType.Library && (wantsStreams || item is Audio))
+                {
+                    itemIds.Add(item.Id);
+                }
+            }
+
+            // A single item costs one query either way.
+            return itemIds.Count > 1 ? prefetch.PrefetchMediaStreams(itemIds) : null;
+        }
+
