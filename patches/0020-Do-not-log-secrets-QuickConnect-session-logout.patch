             {
                 if (expireAll || timestamp < minTime)
                 {
-                    _logger.LogDebug("Removing expired secret {Secret}", secret);
+                    _logger.LogDebug("Removing expired secret.");
                     if (!_authorizedSecrets.TryRemove(secret, out _))
