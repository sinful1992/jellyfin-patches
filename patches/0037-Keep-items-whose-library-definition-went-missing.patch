+    [Fact]
+    public void Perform_LibraryDefinitionMissing_KeepsItsItems()
+    {
+        var libraryId = Guid.Parse("11111111-1111-1111-1111-111111111111");
+        var itemId = Guid.Parse("22222222-2222-2222-2222-222222222222");
